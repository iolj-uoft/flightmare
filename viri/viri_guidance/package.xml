<?xml version="1.0"?>
<package format="2">
  <name>viri_guidance</name>
  <version>0.1.0</version>
  <description>Proportional navigation and hybrid heading/ProNav guidance driven by the relative LTVKF.</description>
  <maintainer email="yangchen.lin@mail.utoronto.ca">Yang-Chen Lin</maintainer>
  <license>GNU GPL</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>quadrotor_msgs</depend>
  <depend>viri_msgs</depend>
  <depend>viri_estimation</depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <exec_depend>autopilot</exec_depend>
  <test_depend>rosunit</test_depend>
</package>
