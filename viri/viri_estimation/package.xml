<?xml version="1.0"?>
<package format="2">
  <name>viri_estimation</name>
  <version>0.1.0</version>
  <description>Gravity-aligned relative LTVKF with rewind-update-replay for delayed stereo measurements.</description>
  <maintainer email="yangchen.lin@mail.utoronto.ca">Yang-Chen Lin</maintainer>
  <license>GNU GPL</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>viri_msgs</depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>
  <test_depend>rosunit</test_depend>
</package>
