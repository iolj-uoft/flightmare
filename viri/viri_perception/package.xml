<?xml version="1.0"?>
<package format="2">
  <name>viri_perception</name>
  <version>0.1.0</version>
  <description>YOLO26n stereo target detection and stereo triangulation with outlier rejection.</description>
  <maintainer email="yangchen.lin@mail.utoronto.ca">Yang-Chen Lin</maintainer>
  <license>GNU GPL</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <build_depend>eigen</build_depend>
  <build_export_depend>eigen</build_export_depend>

  <!-- yolo_stereo_node.py (ultralytics is installed via pip) -->
  <exec_depend>rospy</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>cv_bridge</exec_depend>

  <test_depend>rosunit</test_depend>
</package>
