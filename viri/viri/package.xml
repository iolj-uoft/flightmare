<?xml version="1.0"?>
<package format="2">
  <name>viri</name>
  <version>0.1.0</version>
  <description>Vision-based autonomous drone interceptor (metapackage).</description>
  <maintainer email="yangchen.lin@mail.utoronto.ca">Yang-Chen Lin</maintainer>
  <license>GNU GPL</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>viri_msgs</exec_depend>
  <exec_depend>viri_perception</exec_depend>
  <exec_depend>viri_estimation</exec_depend>
  <exec_depend>viri_guidance</exec_depend>
  <exec_depend>viri_sim</exec_depend>
  <exec_depend>viri_bringup</exec_depend>

  <export>
    <metapackage/>
  </export>
</package>
